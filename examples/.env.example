NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/sdcore_example
DB_SYNCHRONIZE=true
DB_SSL=false

KEYCLOAK_ISSUER=https://keycloak.example.test/realms/sdcore-example
KEYCLOAK_AUDIENCE=sdcore-example-api

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

APP_ORIGIN=http://127.0.0.1:3000
UPSTREAM_API_ORIGIN=https://catalog.example.test

UPLOAD_DRIVER=local
UPLOAD_LOCAL_ROOT=./var/uploads
# For UPLOAD_DRIVER=s3, use the AWS default credential chain and set:
# AWS_REGION=ap-southeast-1
# UPLOAD_BUCKET=replace-with-your-bucket
